{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.somi-beauty.com" }],
      "destination": "https://somi-beauty.com/:path*",
      "permanent": true
    }
  ]
}
